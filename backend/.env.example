# ============================================================
# Variables d'environnement du backend Ubifood
# Copier ce fichier en « .env » (dans backend/) et renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité.
# ============================================================

# ── Sécurité ────────────────────────────────────────────────
# Générer une clé :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
# IP publique et/ou nom de domaine du serveur, séparés par des virgules
ALLOWED_HOSTS=51.20.12.161
# True une fois le certificat HTTPS installé (voir README)
USE_HTTPS=False

# ── Base de données ─────────────────────────────────────────
# DB_HOST=db : nom du service PostgreSQL dans docker-compose
DB_NAME=ubifood
DB_USER=ubifood
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── CORS / CSRF ─────────────────────────────────────────────
# Origine(s) du site Angular
CORS_ALLOWED_ORIGINS=http://51.20.12.161
CSRF_TRUSTED_ORIGINS=http://51.20.12.161

# ── SMS AllMySMS (mot de passe oublié) ──────────────────────
ALLMYSMS_LOGIN=
ALLMYSMS_API_KEY=
ALLMYSMS_SENDER=UbiFood

# ── Firebase (notifications push) ───────────────────────────
# Chemin du fichier JSON du compte de service (non versionné)
FIREBASE_SERVICE_ACCOUNT_KEY=/app/firebase-service-account.json
